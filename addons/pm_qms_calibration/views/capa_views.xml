<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_capa_form_calibration" model="ir.ui.view">
        <field name="name">pm.qms.capa.form.calibration</field>
        <field name="model">pm.qms.capa</field>
        <field name="inherit_id" ref="pm_qms_capa.view_pm_qms_capa_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Calibration">
                    <group>
                        <field name="calibration_event_id"/>
                        <field name="calibration_impact_assessment_id"/>
                        <field name="equipment_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
