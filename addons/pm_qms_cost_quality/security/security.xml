<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_pm_qms_cost_type_company" model="ir.rule">
        <field name="name">QMS cost type company boundary</field>
        <field name="model_id" ref="model_pm_qms_cost_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>
    <record id="rule_pm_qms_cost_event_company" model="ir.rule">
        <field name="name">QMS cost event company boundary</field>
        <field name="model_id" ref="model_pm_qms_cost_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>
    <record id="rule_pm_qms_cost_line_company" model="ir.rule">
        <field name="name">QMS cost line company boundary</field>
        <field name="model_id" ref="model_pm_qms_cost_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>
</odoo>
