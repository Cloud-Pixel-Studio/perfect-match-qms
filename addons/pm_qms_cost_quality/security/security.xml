<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_pm_qms_cost_type_company" model="ir.rule">
        <field name="name">QMS cost type company boundary</field>
        <field name="model_id" ref="model_pm_qms_cost_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>
    <record id="rule_pm_qms_cost_event_company" model="ir.rule">
        <field name="name">QMS cost event company boundary</field>
        <field name="model_id" ref="model_pm_qms_cost_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>
    <record id="rule_pm_qms_cost_line_company" model="ir.rule">
        <field name="name">QMS cost line company boundary</field>
        <field name="model_id" ref="model_pm_qms_cost_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>

    <record id="rule_m19_cost_event_scope" model="ir.rule"><field name="name">Mission 19 cost event scope</field><field name="model_id" ref="model_pm_qms_cost_event"/><field name="global" eval="True"/><field name="domain_force">[('organization_id', 'in', user.qms_effective_organization_ids.ids), '|', ('process_id', '=', False), ('process_id', 'in', user.qms_effective_process_ids.ids)]</field></record>
    <record id="rule_m19_cost_line_scope" model="ir.rule"><field name="name">Mission 19 cost line scope</field><field name="model_id" ref="model_pm_qms_cost_line"/><field name="global" eval="True"/><field name="domain_force">[('organization_id', 'in', user.qms_effective_organization_ids.ids)]</field></record>
    <record id="access_m19_manager_cost_type" model="ir.model.access"><field name="name">Mission 19 manager cost type</field><field name="model_id" ref="model_pm_qms_cost_type"/><field name="group_id" ref="pm_qms_core.group_pm_qms_manager"/><field name="perm_read" eval="1"/><field name="perm_write" eval="1"/><field name="perm_create" eval="1"/></record>
    <record id="access_m19_manager_cost_event" model="ir.model.access"><field name="name">Mission 19 manager cost event</field><field name="model_id" ref="model_pm_qms_cost_event"/><field name="group_id" ref="pm_qms_core.group_pm_qms_manager"/><field name="perm_read" eval="1"/><field name="perm_write" eval="1"/><field name="perm_create" eval="1"/></record>
    <record id="access_m19_manager_cost_line" model="ir.model.access"><field name="name">Mission 19 manager cost line</field><field name="model_id" ref="model_pm_qms_cost_line"/><field name="group_id" ref="pm_qms_core.group_pm_qms_manager"/><field name="perm_read" eval="1"/><field name="perm_write" eval="1"/><field name="perm_create" eval="1"/></record>
</odoo>
