<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_dashboard_form_cost_quality" model="ir.ui.view">
        <field name="name">pm.qms.dashboard.form.cost.quality</field>
        <field name="model">pm.qms.dashboard</field>
        <field name="inherit_id" ref="pm_qms_app.view_pm_qms_dashboard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_cost_quality" type="object" class="oe_stat_button" icon="fa-money" groups="pm_qms_core.group_qms_quality_manager,pm_qms_core.group_qms_management_user,pm_qms_core.group_pm_qms_administrator,base.group_system">
                    <field name="dashboard_copq_amount" widget="statinfo" string="COPQ"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='supplier_performance_issues']/.." position="after">
                <group string="Cost of Quality" groups="pm_qms_core.group_qms_quality_manager,pm_qms_core.group_qms_management_user,pm_qms_core.group_pm_qms_administrator,base.group_system">
                    <button name="action_view_cost_quality" type="object" string="Open Cost Analytics" class="oe_link"/>
                    <field name="quality_cost_event_count"/>
                    <field name="dashboard_quality_cost_total"/>
                    <field name="dashboard_copq_amount"/>
                    <field name="dashboard_recovery_total"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
