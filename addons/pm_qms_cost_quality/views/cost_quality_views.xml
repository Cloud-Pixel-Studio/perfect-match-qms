<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_cost_type_list" model="ir.ui.view">
        <field name="name">pm.qms.cost.type.list</field>
        <field name="model">pm.qms.cost.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_pm_qms_cost_type_form" model="ir.ui.view">
        <field name="name">pm.qms.cost.type.form</field>
        <field name="model">pm.qms.cost.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_pm_qms_cost_event_list" model="ir.ui.view">
        <field name="name">pm.qms.cost.event.list</field>
        <field name="model">pm.qms.cost.event</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'confirmed'">
                <field name="code"/>
                <field name="name"/>
                <field name="event_date"/>
                <field name="organization_id"/>
                <field name="process_id"/>
                <field name="source_identifier"/>
                <field name="quality_cost_total" sum="Total Cost"/>
                <field name="recovery_total" sum="Recovery"/>
                <field name="copq_amount" sum="COPQ"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_pm_qms_cost_event_form" model="ir.ui.view">
        <field name="name">pm.qms.cost.event.form</field>
        <field name="model">pm.qms.cost.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <button name="action_create_correction" type="object" string="Create Correction" invisible="state != 'confirmed'"/>
                    <button name="action_open_source" type="object" string="Open Source" invisible="not source_model or not source_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="event_date"/>
                            <field name="organization_id"/>
                            <field name="process_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Source Traceability">
                            <field name="source_model"/>
                            <field name="source_id"/>
                            <field name="source_identifier"/>
                            <field name="source_title"/>
                            <field name="correction_of_id"/>
                        </group>
                    </group>
                    <group string="Totals">
                        <group>
                            <field name="quality_cost_total"/>
                            <field name="recovery_total"/>
                            <field name="net_quality_cost"/>
                            <field name="copq_amount"/>
                        </group>
                        <group>
                            <field name="prevention_total"/>
                            <field name="appraisal_total"/>
                            <field name="internal_failure_total"/>
                            <field name="external_failure_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost Lines">
                            <field name="line_ids" readonly="state == 'confirmed'">
                                <list editable="bottom">
                                    <field name="cost_type_id"/>
                                    <field name="category"/>
                                    <field name="description"/>
                                    <field name="amount"/>
                                    <field name="recovery_amount"/>
                                    <field name="net_amount"/>
                                    <field name="is_estimated"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Corrections">
                            <field name="correction_event_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_pm_qms_cost_event_search" model="ir.ui.view">
        <field name="name">pm.qms.cost.event.search</field>
        <field name="model">pm.qms.cost.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="official" string="Official Analytics" domain="[('state', '=', 'confirmed')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
            </search>
        </field>
    </record>
    <record id="view_pm_qms_cost_event_pivot" model="ir.ui.view">
        <field name="name">pm.qms.cost.event.pivot</field>
        <field name="model">pm.qms.cost.event</field>
        <field name="arch" type="xml">
            <pivot string="Cost of Quality">
                <field name="organization_id" type="row"/>
                <field name="event_date" interval="month" type="col"/>
                <field name="quality_cost_total" type="measure"/>
                <field name="copq_amount" type="measure"/>
                <field name="recovery_total" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_pm_qms_cost_event_graph" model="ir.ui.view">
        <field name="name">pm.qms.cost.event.graph</field>
        <field name="model">pm.qms.cost.event</field>
        <field name="arch" type="xml">
            <graph string="Cost of Quality" type="bar">
                <field name="event_date" interval="month"/>
                <field name="copq_amount" type="measure"/>
                <field name="quality_cost_total" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_pm_qms_cost_type" model="ir.actions.act_window">
        <field name="name">Cost Types</field>
        <field name="res_model">pm.qms.cost.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_pm_qms_cost_event" model="ir.actions.act_window">
        <field name="name">Cost Events</field>
        <field name="res_model">pm.qms.cost.event</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_pm_qms_cost_event_search"/>
    </record>
    <record id="action_pm_qms_cost_event_official" model="ir.actions.act_window">
        <field name="name">Cost Analytics</field>
        <field name="res_model">pm.qms.cost.event</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
        <field name="search_view_id" ref="view_pm_qms_cost_event_search"/>
        <field name="context">{'search_default_official': 1}</field>
    </record>
</odoo>
