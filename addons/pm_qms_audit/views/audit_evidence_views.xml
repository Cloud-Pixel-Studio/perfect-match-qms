<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_audit_evidence_list" model="ir.ui.view">
        <field name="name">pm.qms.audit.evidence.list</field>
        <field name="model">pm.qms.audit.evidence</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="audit_id"/>
                <field name="criterion_id"/>
                <field name="source"/>
                <field name="document_id"/>
                <field name="control_instance_id"/>
                <field name="collected_by_id"/>
                <field name="collected_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_audit_evidence_form" model="ir.ui.view">
        <field name="name">pm.qms.audit.evidence.form</field>
        <field name="model">pm.qms.audit.evidence</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Audit">
                            <field name="audit_id"/>
                            <field name="criterion_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="organization_id"/>
                            <field name="source"/>
                            <field name="active"/>
                        </group>
                        <group string="Collection">
                            <field name="collected_by_id"/>
                            <field name="collected_date"/>
                            <field name="document_id"/>
                            <field name="control_instance_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_audit_evidence_search" model="ir.ui.view">
        <field name="name">pm.qms.audit.evidence.search</field>
        <field name="model">pm.qms.audit.evidence</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="audit_id"/>
                <field name="criterion_id"/>
                <field name="source"/>
                <field name="document_id"/>
                <field name="control_instance_id"/>
                <filter name="group_audit" string="Audit" context="{'group_by': 'audit_id'}"/>
                <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                <filter name="group_collector" string="Collected By" context="{'group_by': 'collected_by_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_pm_qms_audit_evidence" model="ir.actions.act_window">
        <field name="name">Audit Evidence</field>
        <field name="res_model">pm.qms.audit.evidence</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_qms_audit_evidence_search"/>
    </record>
</odoo>
