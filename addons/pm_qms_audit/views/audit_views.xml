<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_audit_list" model="ir.ui.view">
        <field name="name">pm.qms.audit.list</field>
        <field name="model">pm.qms.audit</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="audit_type"/>
                <field name="organization_id"/>
                <field name="planned_start"/>
                <field name="planned_end"/>
                <field name="actual_start"/>
                <field name="actual_end"/>
                <field name="lead_auditor_id"/>
                <field name="total_finding_count"/>
                <field name="open_finding_count"/>
                <field name="ncr_count"/>
                <field name="is_overdue"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_audit_form" model="ir.ui.view">
        <field name="name">pm.qms.audit.form</field>
        <field name="model">pm.qms.audit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_plan" type="object" string="Plan" invisible="state != 'draft'"/>
                    <button name="action_record_independence" type="object" string="Confirm Independence" invisible="state not in ('draft', 'planned')"/>
                    <button name="action_record_independence_override" type="object" string="Override Independence" invisible="state not in ('draft', 'planned')"/>
                    <button name="action_mark_ready" type="object" string="Ready" invisible="state != 'planned'"/>
                    <button name="action_start" type="object" string="Start" invisible="state != 'ready'"/>
                    <button name="action_start_reporting" type="object" string="Reporting" invisible="state != 'in_progress'"/>
                    <button name="action_complete" type="object" string="Complete" invisible="state != 'reporting'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,ready,in_progress,reporting,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="program_id"/>
                            <field name="organization_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="audit_type"/>
                            <field name="active"/>
                        </group>
                        <group string="Dates">
                            <field name="planned_start"/>
                            <field name="planned_end"/>
                            <field name="actual_start"/>
                            <field name="actual_end"/>
                            <field name="is_overdue"/>
                            <field name="days_overdue"/>
                        </group>
                    </group>
                    <group string="Team">
                        <field name="lead_auditor_id"/>
                        <field name="auditor_ids" widget="many2many_tags"/>
                        <field name="auditee_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Summary">
                        <field name="total_finding_count"/>
                        <field name="conformity_count"/>
                        <field name="observation_count"/>
                        <field name="ofi_count"/>
                        <field name="nonconformity_count"/>
                        <field name="open_finding_count"/>
                        <field name="ncr_count"/>
                    </group>
                    <notebook>
                        <page string="Objective">
                            <field name="objective"/>
                        </page>
                        <page string="Scope Summary">
                            <field name="scope_summary"/>
                        </page>
                        <page string="Scope">
                            <field name="scope_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="organization_id"/>
                                    <field name="process_id"/>
                                    <field name="control_instance_ids" widget="many2many_tags"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Criteria">
                            <field name="criterion_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="criterion_type"/>
                                    <field name="control_id"/>
                                    <field name="control_instance_id"/>
                                    <field name="external_mapping_id"/>
                                    <field name="reference"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Plan">
                            <field name="plan_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="planned_datetime"/>
                                    <field name="duration"/>
                                    <field name="process_id"/>
                                    <field name="activity"/>
                                    <field name="auditor_id"/>
                                    <field name="auditee_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Evidence">
                            <field name="audit_evidence_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="criterion_id"/>
                                    <field name="source"/>
                                    <field name="document_id"/>
                                    <field name="control_instance_id"/>
                                    <field name="collected_by_id"/>
                                    <field name="collected_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Findings">
                            <field name="finding_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="title"/>
                                    <field name="classification"/>
                                    <field name="severity"/>
                                    <field name="process_id"/>
                                    <field name="control_instance_id"/>
                                    <field name="owner_id"/>
                                    <field name="due_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Independence">
                            <group>
                                <field name="independence_required"/>
                                <field name="independence_confirmed"/>
                                <field name="independence_reviewed_by_id"/>
                                <field name="independence_review_date"/>
                            </group>
                            <field name="independence_notes"/>
                        </page>
                        <page string="Conclusion">
                            <field name="conclusion"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_audit_search" model="ir.ui.view">
        <field name="name">pm.qms.audit.search</field>
        <field name="model">pm.qms.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="organization_id"/>
                <field name="lead_auditor_id"/>
                <filter name="open" string="Open Audits" domain="[('state', 'not in', ('completed', 'cancelled'))]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Audit Type" context="{'group_by': 'audit_type'}"/>
                <filter name="group_org" string="Organization" context="{'group_by': 'organization_id'}"/>
                <filter name="group_lead" string="Lead Auditor" context="{'group_by': 'lead_auditor_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_pm_qms_audit_pivot" model="ir.ui.view">
        <field name="name">pm.qms.audit.pivot</field>
        <field name="model">pm.qms.audit</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="state" type="row"/>
                <field name="audit_type" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_pm_qms_audit_graph" model="ir.ui.view">
        <field name="name">pm.qms.audit.graph</field>
        <field name="model">pm.qms.audit</field>
        <field name="arch" type="xml">
            <graph string="Audits by Status">
                <field name="state" type="row"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_pm_qms_audit" model="ir.actions.act_window">
        <field name="name">Audits</field>
        <field name="res_model">pm.qms.audit</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_pm_qms_audit_search"/>
    </record>
</odoo>
