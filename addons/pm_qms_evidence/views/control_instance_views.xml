<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_control_instance_form_evidence" model="ir.ui.view">
        <field name="name">pm.qms.control.instance.form.evidence</field>
        <field name="model">pm.qms.control.instance</field>
        <field name="inherit_id" ref="pm_qms_core.view_pm_qms_control_instance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Evidence Completion">
                    <group>
                        <field name="required_evidence_count"/>
                        <field name="accepted_evidence_count"/>
                        <field name="missing_evidence_count"/>
                    </group>
                    <field name="evidence_ids">
                        <list>
                            <field name="name"/>
                            <field name="evidence_requirement_id"/>
                            <field name="evidence_type"/>
                            <field name="owner_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
