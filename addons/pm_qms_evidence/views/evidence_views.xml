<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_evidence_list" model="ir.ui.view">
        <field name="name">pm.qms.evidence.list</field>
        <field name="model">pm.qms.evidence</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'accepted'" decoration-warning="state in ('submitted', 'under_review')" decoration-danger="state in ('rejected', 'expired')" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="control_instance_id"/>
                <field name="evidence_requirement_id"/>
                <field name="organization_id"/>
                <field name="process_id"/>
                <field name="evidence_type"/>
                <field name="owner_id"/>
                <field name="evidence_date"/>
                <field name="review_date"/>
                <field name="state"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_evidence_form" model="ir.ui.view">
        <field name="name">pm.qms.evidence.form</field>
        <field name="model">pm.qms.evidence</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit Evidence" invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Review" invisible="state != 'submitted'"/>
                    <button name="action_accept" type="object" string="Accept" invisible="state not in ('submitted', 'under_review')"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state not in ('submitted', 'under_review')"/>
                    <button name="action_expire" type="object" string="Expire" invisible="state != 'accepted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,accepted,rejected,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Implementation">
                            <field name="control_instance_id"/>
                            <field name="evidence_requirement_id"/>
                            <field name="requirement_description" readonly="1"/>
                            <field name="requirement_acceptance_criteria" readonly="1"/>
                            <field name="organization_id"/>
                            <field name="process_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Evidence">
                            <field name="evidence_type"/>
                            <field name="owner_id"/>
                            <field name="evidence_date"/>
                            <field name="expiration_date"/>
                            <field name="review_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Documents">
                            <field name="document_ids"/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids"/>
                        </page>
                        <page string="Review">
                            <group>
                                <field name="reviewer_id"/>
                                <field name="reviewed_on"/>
                            </group>
                            <field name="review_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_evidence_search" model="ir.ui.view">
        <field name="name">pm.qms.evidence.search</field>
        <field name="model">pm.qms.evidence</field>
        <field name="arch" type="xml">
            <search string="Evidence">
                <field name="name"/>
                <field name="control_instance_id"/>
                <field name="evidence_requirement_id"/>
                <field name="organization_id"/>
                <field name="owner_id"/>
                <filter name="pending_review" string="Pending Review" domain="[('state', 'in', ('submitted', 'under_review'))]"/>
                <filter name="accepted" string="Accepted" domain="[('state', '=', 'accepted')]"/>
                <filter name="missing_or_rejected" string="Rejected / Expired" domain="[('state', 'in', ('rejected', 'expired'))]"/>
                <separator/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_organization" string="Organization" context="{'group_by': 'organization_id'}"/>
                <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_pm_qms_evidence" model="ir.actions.act_window">
        <field name="name">Evidence Records</field>
        <field name="res_model">pm.qms.evidence</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_qms_evidence_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No evidence records yet</p>
            <p>Evidence records show proof that controls are implemented, reviewed, and ready for assessment.</p>
        </field>
    </record>
</odoo>
