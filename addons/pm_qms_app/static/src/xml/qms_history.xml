<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Chatter-top')]" position="before">
            <div t-if="isQmsCustomerHistory" class="o_pm_qms_activity_history_header">
                QMS Activity &amp; History
            </div>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="attributes">
            <attribute name="t-if">not isQmsCustomerHistory</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="replace" mode="inner">
            <t t-if="isQmsCustomerHistory">Internal Note</t>
            <t t-else="">Log note</t>
        </xpath>
        <xpath expr="//div[hasclass('o-mail-Followers')]" position="attributes">
            <attribute name="t-if">not isQmsCustomerHistory</attribute>
        </xpath>
    </t>
</templates>
