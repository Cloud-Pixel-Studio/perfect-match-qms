<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Framework definitions are reusable Perfect Match master data. QMS
         Managers can use generated implementation records, while only the
         existing QMS Administrator group can change the master definitions. -->
    <record id="access_m19_manager_control" model="ir.model.access">
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
