<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Child records inherit the same tenant scope as their owning QMS record.
         Company-level definitions remain reusable; records with an optional
         organization are allowed only when they are explicitly unscoped. -->
    <record id="rule_m28_event_scope" model="ir.rule">
        <field name="name">M28 operational event scope</field>
        <field name="model_id" ref="pm_qms_core.model_pm_qms_event"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids), '|', ('organization_id', '=', False), ('organization_id', 'in', user.qms_effective_organization_ids.ids)]</field>
    </record>

