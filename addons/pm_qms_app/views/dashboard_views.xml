<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_dashboard_form" model="ir.ui.view">
        <field name="name">pm.qms.dashboard.form</field>
        <field name="model">pm.qms.dashboard</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <field name="organization_count" invisible="1"/>
                    <field name="has_multiple_organizations" invisible="1"/>
                    <div class="oe_title">
                        <h1>Perfect Match QMS</h1>
                    </div>
                    <group>
                        <group>
                            <field name="organization_id" options="{'no_create': True}"/>
                            <field name="implementation_project_id" domain="[('organization_id', '=', organization_id)]" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="dashboard_timestamp"/>
                            <field name="last_management_review_date"/>
                        </group>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_continue_implementation" type="object" class="oe_stat_button" icon="fa-play">
                            <field name="readiness_percent" widget="statinfo" string="Readiness %"/>
                        </button>
                        <button name="action_review_gaps" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="gap_controls" widget="statinfo" string="Control Gaps"/>
                        </button>
                        <button name="action_review_evidence" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="missing_evidence" widget="statinfo" string="Missing Evidence"/>
                        </button>
                        <button name="action_run_readiness_assessment" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <field name="total_controls" widget="statinfo" string="Controls"/>
                        </button>
                        <button name="action_view_risks" type="object" class="oe_stat_button" icon="fa-warning">
                            <field name="open_risks" widget="statinfo" string="Open Risks"/>
                        </button>
                        <button name="action_view_nonconformities" type="object" class="oe_stat_button" icon="fa-search">
                            <field name="open_ncr" widget="statinfo" string="Open NCR"/>
                        </button>
                        <button name="action_view_capa" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <field name="open_capa" widget="statinfo" string="Open CAPA"/>
                        </button>
                        <button name="action_view_audit_findings" type="object" class="oe_stat_button" icon="fa-flag">
                            <field name="open_audit_findings" widget="statinfo" string="Audit Findings"/>
                        </button>
                    </div>
                    <group string="Implementation Readiness">
                        <group string="Controls">
                            <field name="total_controls"/>
                            <field name="ready_controls"/>
                            <field name="partial_controls"/>
                            <field name="gap_controls"/>
                            <field name="not_applicable_controls"/>
                        </group>
                        <group string="Activities">
                            <field name="total_activities"/>
                            <field name="completed_activities"/>
                            <field name="open_activities"/>
                            <field name="overdue_activities"/>
                        </group>
                        <group string="Evidence">
                            <field name="required_evidence"/>
                            <field name="accepted_evidence"/>
                            <field name="missing_evidence"/>
                            <field name="pending_review_evidence"/>
                        </group>
                    </group>
                    <group string="QMS Health">
                        <group>
                            <field name="open_risks"/>
                            <field name="high_open_risks"/>
                            <field name="open_ncr"/>
                            <field name="overdue_ncr"/>
                        </group>
                        <group>
                            <field name="open_capa"/>
                            <field name="overdue_capa"/>
                            <field name="open_audit_findings"/>
                            <field name="overdue_audit_findings"/>
                        </group>
                    </group>
                    <group string="Performance">
                        <group>
                            <button name="action_view_objectives" type="object" string="Quality Objectives" class="oe_link"/>
                            <field name="active_objectives"/>
                            <field name="objectives_on_target"/>
                        </group>
                        <group>
                            <button name="action_view_kpis" type="object" string="KPIs" class="oe_link"/>
                            <field name="active_kpis"/>
                            <field name="kpis_on_target"/>
                            <field name="customer_performance_issues"/>
                            <field name="supplier_performance_issues"/>
                        </group>
                    </group>
                    <group string="Management Review">
                        <button name="action_view_management_reviews" type="object" string="Open Management Reviews" class="oe_link"/>
                        <field name="last_management_review_id"/>
                        <field name="open_management_review_actions"/>
                    </group>
                    <group string="Recommended Next Actions">
                        <group>
                            <field name="next_action_1_name" string="Next Action" readonly="1"/>
                            <field name="next_action_1_reason" string="Reason" readonly="1"/>
                        </group>
                        <group>
                            <field name="next_action_2_name" string="Next Action" readonly="1"/>
                            <field name="next_action_2_reason" string="Reason" readonly="1"/>
                            <field name="next_action_3_name" string="Next Action" readonly="1"/>
                            <field name="next_action_3_reason" string="Reason" readonly="1"/>
                        </group>
                    </group>
                    <group string="Attention Required">
                        <group>
                            <field name="attention_overdue_activities"/>
                            <field name="attention_missing_evidence"/>
                            <field name="attention_high_risks"/>
                        </group>
                        <group>
                            <field name="attention_overdue_capa"/>
                            <field name="attention_open_findings"/>
                        </group>
                        <group string="People &amp; Competency">
                            <button name="action_view_competency_gaps" type="object" string="Competency Attention" class="oe_link"/>
                            <field name="attention_competency_gaps"/>
                            <button name="action_view_overdue_training" type="object" string="Overdue Training" class="oe_link"/>
                            <field name="attention_overdue_training"/>
                        </group>
                        <group string="Awareness &amp; Qualifications">
                            <button name="action_view_expiring_qualifications" type="object" string="Qualification Attention" class="oe_link"/>
                            <field name="attention_expiring_qualifications"/>
                            <button name="action_view_pending_acknowledgments" type="object" string="Pending Acknowledgments" class="oe_link"/>
                            <field name="attention_pending_acknowledgments"/>
                        </group>
                        <group string="Equipment &amp; Calibration">
                            <button name="action_view_calibration_attention" type="object" string="Calibration Attention" class="oe_link"/>
                            <field name="calibration_due_soon"/>
                            <field name="calibration_overdue"/>
                            <field name="quarantined_equipment"/>
                            <button name="action_view_oot_assessments" type="object" string="Open OOT Assessments" class="oe_link"/>
                            <field name="open_calibration_impact_assessments"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_continue_implementation" type="object" string="Continue Implementation" class="btn-primary"/>
                        <button name="action_review_gaps" type="object" string="Review Gaps"/>
                        <button name="action_review_evidence" type="object" string="Review Evidence"/>
                        <button name="action_run_readiness_assessment" type="object" string="Open Readiness Center"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_dashboard" model="ir.actions.act_window">
        <field name="name">Perfect Match QMS</field>
        <field name="res_model">pm.qms.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pm_qms_dashboard_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>
</odoo>
