<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- These are Odoo platform roots, not part of the customer QMS product.
         Technical administrators retain them; QMS access is still enforced by
         the underlying groups, ACLs, rules, and actions. -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="base.menu_apps" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="base.menu_module_tree" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="base.open_module_tree" model="ir.actions.act_window">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="base.menu_tests" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="project.menu_main_pm" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <record id="pm_qms_core.menu_pm_qms_root" model="ir.ui.menu">
        <field name="name">Perfect Match QMS</field>
        <field name="sequence">60</field>
        <field name="web_icon">pm_qms_app,static/description/icon.svg</field>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('pm_qms_app.action_pm_qms_dashboard')"/>
    </record>

    <menuitem
        id="menu_pm_qms_dashboard"
        name="Dashboard"
        parent="pm_qms_core.menu_pm_qms_root"
        action="action_pm_qms_dashboard"
        sequence="1"
        groups="pm_qms_core.group_pm_qms_user,pm_qms_core.group_qms_viewer"/>

    <record id="pm_qms_core.menu_pm_qms_implementation" model="ir.ui.menu">
        <field name="name">Implementations</field>
        <field name="sequence">5</field>
    </record>
    <record id="pm_qms_implementation.menu_pm_qms_project_generator" model="ir.ui.menu">
        <field name="name">New Implementation</field>
        <field name="sequence">5</field>
    </record>
    <record id="pm_qms_implementation.menu_pm_qms_implementation_projects" model="ir.ui.menu">
        <field name="name">Implementations</field>
        <field name="sequence">10</field>
    </record>
    <record id="pm_qms_implementation.menu_pm_qms_implementation_controls" model="ir.ui.menu">
        <field name="name">Controls</field>
        <field name="sequence">20</field>
    </record>
    <record id="pm_qms_implementation.menu_pm_qms_implementation_tasks" model="ir.ui.menu">
        <field name="name">Activities</field>
        <field name="sequence">30</field>
    </record>
    <record id="pm_qms_implementation.menu_pm_qms_readiness_assessments" model="ir.ui.menu">
        <field name="sequence">40</field>
    </record>
    <record id="pm_qms_core.menu_pm_qms_control_instances" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="pm_qms_core.menu_pm_qms_framework" model="ir.ui.menu">
        <field name="name">Framework Administration</field>
        <field name="parent_id" ref="pm_qms_core.menu_pm_qms_configuration"/>
        <field name="sequence">70</field>
        <field name="group_ids" eval="[(6, 0, [ref('pm_qms_core.group_pm_qms_administrator')])]"/>
    </record>
    <record id="pm_qms_core.menu_pm_qms_controls" model="ir.ui.menu">
        <field name="name">Framework Controls</field>
        <field name="sequence">10</field>
    </record>
    <record id="pm_qms_implementation.menu_pm_qms_framework_packs" model="ir.ui.menu">
        <field name="name">Packs</field>
        <field name="sequence">20</field>
    </record>
    <record id="pm_qms_core.menu_pm_qms_activities" model="ir.ui.menu">
        <field name="name">Framework Activities</field>
        <field name="sequence">30</field>
    </record>
    <record id="pm_qms_core.menu_pm_qms_evidence_requirements" model="ir.ui.menu">
        <field name="sequence">40</field>
    </record>
    <record id="pm_qms_core.menu_pm_qms_external_mappings" model="ir.ui.menu">
        <field name="parent_id" ref="pm_qms_core.menu_pm_qms_framework"/>
        <field name="sequence">90</field>
    </record>

    <record id="pm_qms_core.menu_pm_qms_organization" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="pm_qms_core.menu_pm_qms_organizations" model="ir.ui.menu">
        <field name="name">Company Profile</field>
        <field name="parent_id" ref="pm_qms_core.menu_pm_qms_configuration"/>
        <field name="sequence">10</field>
    </record>
    <record id="pm_qms_core.menu_pm_qms_processes" model="ir.ui.menu">
        <field name="parent_id" ref="pm_qms_core.menu_pm_qms_configuration"/>
        <field name="sequence">20</field>
    </record>
    <menuitem
        id="menu_pm_qms_sites"
        name="Sites"
        parent="pm_qms_core.menu_pm_qms_configuration"
        action="pm_qms_core.action_pm_qms_site"
        sequence="30"
        groups="pm_qms_core.group_pm_qms_manager"/>
    <record id="pm_qms_migration.menu_pm_qms_migration" model="ir.ui.menu">
        <field name="name">Administration / Migration</field>
        <field name="sequence">80</field>
        <field name="group_ids" eval="[(6, 0, [ref('pm_qms_core.group_pm_qms_administrator')])]"/>
    </record>

    <record id="pm_qms_documents.menu_pm_qms_documents" model="ir.ui.menu">
        <field name="sequence">10</field>
    </record>
    <record id="pm_qms_evidence.menu_pm_qms_evidence" model="ir.ui.menu">
        <field name="sequence">15</field>
    </record>
    <record id="pm_qms_risk.menu_pm_qms_risk_improvement" model="ir.ui.menu">
        <field name="sequence">20</field>
    </record>
    <record id="pm_qms_audit.menu_pm_qms_audit" model="ir.ui.menu">
        <field name="sequence">30</field>
    </record>
    <record id="pm_qms_kpi.menu_pm_qms_performance" model="ir.ui.menu">
        <field name="sequence">40</field>
    </record>
    <record id="pm_qms_management_review.menu_pm_qms_management_review" model="ir.ui.menu">
        <field name="sequence">50</field>
    </record>

    <record id="pm_qms_implementation.action_pm_qms_implementation_project" model="ir.actions.act_window">
        <field name="name">Implementations</field>
    </record>
    <record id="pm_qms_implementation.action_pm_qms_implementation_control" model="ir.actions.act_window">
        <field name="name">Controls</field>
    </record>
    <record id="pm_qms_implementation.action_pm_qms_implementation_activities" model="ir.actions.act_window">
        <field name="name">Activities</field>
    </record>
    <record id="pm_qms_implementation.action_pm_qms_generated_task" model="ir.actions.act_window">
        <field name="name">Activities</field>
    </record>
</odoo>
