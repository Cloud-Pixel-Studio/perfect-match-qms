<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_control_instance_form_risk" model="ir.ui.view">
        <field name="name">pm.qms.control.instance.form.risk</field>
        <field name="model">pm.qms.control.instance</field>
        <field name="inherit_id" ref="pm_qms_core.view_pm_qms_control_instance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Risks &amp; Opportunities">
                    <field name="risk_ids"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
