<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_kpi_measurement_list" model="ir.ui.view">
        <field name="name">pm.qms.kpi.measurement.list</field>
        <field name="model">pm.qms.kpi.measurement</field>
        <field name="arch" type="xml">
            <list>
                <field name="kpi_id"/>
                <field name="organization_id"/>
                <field name="measurement_date"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="value"/>
                <field name="target_value_snapshot"/>
                <field name="status"/>
                <field name="source_type"/>
                <field name="verified_by_id"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_kpi_measurement_form" model="ir.ui.view">
        <field name="name">pm.qms.kpi.measurement.form</field>
        <field name="model">pm.qms.kpi.measurement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify" type="object" string="Verify" invisible="verified_by_id"/>
                </header>
                <sheet>
                    <group>
                        <group string="Measurement">
                            <field name="kpi_id"/>
                            <field name="organization_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="measurement_date"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="value"/>
                            <field name="source_type"/>
                            <field name="status"/>
                        </group>
                        <group string="Historical Snapshot">
                            <field name="target_value_snapshot"/>
                            <field name="warning_value_snapshot"/>
                            <field name="direction_snapshot"/>
                            <field name="recorded_by_id"/>
                            <field name="recorded_date"/>
                            <field name="verified_by_id"/>
                            <field name="verification_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_kpi_measurement_search" model="ir.ui.view">
        <field name="name">pm.qms.kpi.measurement.search</field>
        <field name="model">pm.qms.kpi.measurement</field>
        <field name="arch" type="xml">
            <search>
                <field name="kpi_id"/>
                <field name="organization_id"/>
                <field name="status"/>
                <field name="measurement_date"/>
                <filter name="on_target" string="On Target" domain="[('status', '=', 'on_target')]"/>
                <filter name="warning" string="Warning" domain="[('status', '=', 'warning')]"/>
                <filter name="off_target" string="Off Target" domain="[('status', '=', 'off_target')]"/>
                <filter name="verified" string="Verified" domain="[('verified_by_id', '!=', False)]"/>
                <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                <filter name="group_kpi" string="KPI" context="{'group_by': 'kpi_id'}"/>
                <filter name="group_month" string="Period Month" context="{'group_by': 'period_end:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_pm_qms_kpi_measurement_pivot" model="ir.ui.view">
        <field name="name">pm.qms.kpi.measurement.pivot</field>
        <field name="model">pm.qms.kpi.measurement</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="kpi_id" type="row"/>
                <field name="status" type="col"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pm_qms_kpi_measurement_graph" model="ir.ui.view">
        <field name="name">pm.qms.kpi.measurement.graph</field>
        <field name="model">pm.qms.kpi.measurement</field>
        <field name="arch" type="xml">
            <graph string="KPI Results">
                <field name="measurement_date" interval="month"/>
                <field name="value" type="measure"/>
                <field name="kpi_id"/>
            </graph>
        </field>
    </record>

    <record id="action_pm_qms_kpi_measurement" model="ir.actions.act_window">
        <field name="name">KPI Measurements</field>
        <field name="res_model">pm.qms.kpi.measurement</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_pm_qms_kpi_measurement_search"/>
    </record>
</odoo>
