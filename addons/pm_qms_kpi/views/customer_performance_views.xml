<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_customer_performance_list" model="ir.ui.view">
        <field name="name">pm.qms.customer.performance.list</field>
        <field name="model">pm.qms.customer.performance</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
                <field name="organization_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="customer_satisfaction_score"/>
                <field name="complaint_count"/>
                <field name="open_complaint_count"/>
                <field name="return_count"/>
                <field name="rejection_count"/>
                <field name="delivery_performance"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_customer_performance_form" model="ir.ui.view">
        <field name="name">pm.qms.customer.performance.form</field>
        <field name="model">pm.qms.customer.performance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Customer">
                            <field name="customer_id"/>
                            <field name="organization_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="active"/>
                        </group>
                        <group string="Metrics">
                            <field name="customer_satisfaction_score"/>
                            <field name="manual_complaint_count"/>
                            <field name="ncr_count"/>
                            <field name="complaint_count"/>
                            <field name="open_complaint_count"/>
                            <field name="return_count"/>
                            <field name="rejection_count"/>
                            <field name="delivery_performance"/>
                            <field name="survey_response_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_customer_performance_search" model="ir.ui.view">
        <field name="name">pm.qms.customer.performance.search</field>
        <field name="model">pm.qms.customer.performance</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_id"/>
                <field name="organization_id"/>
                <field name="period_end"/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                <filter name="group_period" string="Period" context="{'group_by': 'period_end:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_pm_qms_customer_performance_pivot" model="ir.ui.view">
        <field name="name">pm.qms.customer.performance.pivot</field>
        <field name="model">pm.qms.customer.performance</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="customer_id" type="row"/>
                <field name="period_end" interval="month" type="col"/>
                <field name="customer_satisfaction_score" type="measure"/>
                <field name="delivery_performance" type="measure"/>
                <field name="manual_complaint_count" type="measure"/>
                <field name="return_count" type="measure"/>
                <field name="rejection_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pm_qms_customer_performance_graph" model="ir.ui.view">
        <field name="name">pm.qms.customer.performance.graph</field>
        <field name="model">pm.qms.customer.performance</field>
        <field name="arch" type="xml">
            <graph string="Customer Performance">
                <field name="period_end" interval="month"/>
                <field name="customer_satisfaction_score" type="measure"/>
                <field name="delivery_performance" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_pm_qms_customer_performance" model="ir.actions.act_window">
        <field name="name">Customer Performance</field>
        <field name="res_model">pm.qms.customer.performance</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_pm_qms_customer_performance_search"/>
    </record>
</odoo>
