<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_document_list" model="ir.ui.view">
        <field name="name">pm.qms.document.list</field>
        <field name="model">pm.qms.document</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ('approved', 'active')" decoration-warning="state == 'under_review'" decoration-muted="state == 'obsolete'">
                <field name="code"/>
                <field name="name"/>
                <field name="document_type"/>
                <field name="organization_id"/>
                <field name="process_id"/>
                <field name="owner_id"/>
                <field name="current_revision"/>
                <field name="state"/>
                <field name="effective_date"/>
                <field name="review_date"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_document_form" model="ir.ui.view">
        <field name="name">pm.qms.document.form</field>
        <field name="model">pm.qms.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_for_review" type="object" string="Submit for Review" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" invisible="state != 'under_review'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'under_review'"/>
                    <button name="action_activate" type="object" string="Activate" invisible="state not in ('approved', 'draft')"/>
                    <button name="action_create_new_revision" type="object" string="Create New Revision"/>
                    <button name="action_obsolete" type="object" string="Obsolete" invisible="state == 'obsolete'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,under_review,approved,active,obsolete"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="document_type"/>
                            <field name="organization_id"/>
                            <field name="process_id"/>
                        </group>
                        <group string="Control">
                            <field name="owner_id"/>
                            <field name="current_revision_id"/>
                            <field name="current_revision"/>
                            <field name="effective_date"/>
                            <field name="review_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" optional="hide"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Revisions">
                            <field name="revision_ids">
                                <list>
                                    <field name="revision"/>
                                    <field name="revision_date"/>
                                    <field name="effective_date"/>
                                    <field name="state"/>
                                    <field name="prepared_by"/>
                                    <field name="approved_by"/>
                                </list>
                            </field>
                        </page>
                        <page string="Related Controls">
                            <group>
                                <field name="related_control_ids" widget="many2many_tags"/>
                                <field name="related_control_instance_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="History">
                            <field name="current_revision_id"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_document_search" model="ir.ui.view">
        <field name="name">pm.qms.document.search</field>
        <field name="model">pm.qms.document</field>
        <field name="arch" type="xml">
            <search string="Controlled Documents">
                <field name="name"/>
                <field name="code"/>
                <field name="organization_id"/>
                <field name="process_id"/>
                <field name="owner_id"/>
                <filter name="active_documents" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="under_review" string="Under Review" domain="[('state', '=', 'under_review')]"/>
                <filter name="obsolete" string="Obsolete" domain="[('state', '=', 'obsolete')]"/>
                <separator/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'document_type'}"/>
                <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_pm_qms_document" model="ir.actions.act_window">
        <field name="name">Controlled Documents</field>
        <field name="res_model">pm.qms.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_qms_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No controlled documents yet</p>
            <p>Controlled documents keep policies, procedures, forms, and revisions under review and approval.</p>
        </field>
    </record>
</odoo>
