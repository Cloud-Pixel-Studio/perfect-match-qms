<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_implementation_control_list" model="ir.ui.view">
        <field name="name">pm.qms.implementation.control.list</field>
        <field name="model">pm.qms.implementation.control</field>
        <field name="arch" type="xml">
            <list>
                <field name="implementation_project_id"/>
                <field name="control_id"/>
                <field name="control_instance_id"/>
                <field name="pack_ids" widget="many2many_tags"/>
                <field name="required"/>
                <field name="implementation_status"/>
                <field name="applicability"/>
                <field name="readiness_state"/>
                <field name="gap_reason"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_implementation_control_form" model="ir.ui.view">
        <field name="name">pm.qms.implementation.control.form</field>
        <field name="model">pm.qms.implementation.control</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_missing_tasks" type="object" string="Generate Missing Tasks"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="implementation_project_id"/>
                            <field name="control_id"/>
                            <field name="control_instance_id"/>
                            <field name="pack_ids" widget="many2many_tags"/>
                            <field name="required"/>
                        </group>
                        <group>
                            <field name="applicability"/>
                            <field name="implementation_status"/>
                            <field name="readiness_state"/>
                            <field name="gap_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evidence">
                            <group>
                                <field name="required_evidence_count"/>
                                <field name="accepted_evidence_count"/>
                                <field name="missing_evidence_count"/>
                                <field name="evidence_under_review_count"/>
                            </group>
                        </page>
                        <page string="Activities">
                            <group>
                                <field name="required_activity_count"/>
                                <field name="completed_activity_count"/>
                                <field name="open_activity_count"/>
                                <field name="overdue_activity_count"/>
                            </group>
                            <field name="task_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="pm_activity_id"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="state"/>
                                    <field name="date_deadline"/>
                                    <field name="pm_required"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_implementation_control_search" model="ir.ui.view">
        <field name="name">pm.qms.implementation.control.search</field>
        <field name="model">pm.qms.implementation.control</field>
        <field name="arch" type="xml">
            <search>
                <field name="implementation_project_id"/>
                <field name="control_id"/>
                <filter name="ready" string="Ready" domain="[('readiness_state', '=', 'ready')]"/>
                <filter name="gap" string="Gap" domain="[('readiness_state', '=', 'gap')]"/>
                <filter name="group_project" string="Project" context="{'group_by': 'implementation_project_id'}"/>
                <filter name="group_readiness" string="Readiness" context="{'group_by': 'readiness_state'}"/>
            </search>
        </field>
    </record>

    <record id="action_pm_qms_implementation_control" model="ir.actions.act_window">
        <field name="name">Implementation Controls</field>
        <field name="res_model">pm.qms.implementation.control</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_qms_implementation_control_search"/>
    </record>
</odoo>
