<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_project_task_list" model="ir.ui.view">
        <field name="name">pm.qms.project.task.list</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="pm_implementation_project_id"/>
                <field name="pm_implementation_control_id"/>
                <field name="pm_activity_id"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="state"/>
                <field name="date_deadline"/>
                <field name="pm_required"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_project_task_form" model="ir.ui.view">
        <field name="name">pm.qms.project.task.form</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="state"/>
                            <field name="date_deadline"/>
                        </group>
                        <group string="QMS Traceability">
                            <field name="pm_implementation_project_id"/>
                            <field name="pm_implementation_control_id"/>
                            <field name="pm_control_instance_id"/>
                            <field name="pm_activity_id"/>
                            <field name="pm_generated"/>
                            <field name="pm_required"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_generated_task" model="ir.actions.act_window">
        <field name="name">Implementation Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pm_generated', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_pm_qms_project_task_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_pm_qms_project_task_form')})]"/>
    </record>
</odoo>
