<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_site_list" model="ir.ui.view">
        <field name="name">pm.qms.site.list</field>
        <field name="model">pm.qms.site</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="organization_id"/>
                <field name="site_type"/>
                <field name="is_primary"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_site_form" model="ir.ui.view">
        <field name="name">pm.qms.site.form</field>
        <field name="model">pm.qms.site</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="organization_id"/>
                            <field name="site_type"/>
                            <field name="is_primary"/>
                            <field name="active"/>
                        </group>
                        <group string="Site Contact">
                            <field name="partner_id"/>
                            <field name="manager_id"/>
                            <field name="timezone"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_site_search" model="ir.ui.view">
        <field name="name">pm.qms.site.search</field>
        <field name="model">pm.qms.site</field>
        <field name="arch" type="xml">
            <search string="Sites">
                <field name="name"/>
                <field name="code"/>
                <field name="organization_id"/>
                <field name="site_type"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="primary" string="Primary" domain="[('is_primary', '=', True)]"/>
                <filter name="group_organization" string="Organization" context="{'group_by': 'organization_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'site_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_pm_qms_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">pm.qms.site</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_qms_site_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sites yet</p>
            <p>Sites organize operational locations without imposing a limit on the organization.</p>
        </field>
    </record>
</odoo>
