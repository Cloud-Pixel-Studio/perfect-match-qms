<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_organization_list" model="ir.ui.view">
        <field name="name">pm.qms.organization.list</field>
        <field name="model">pm.qms.organization</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_organization_form" model="ir.ui.view">
        <field name="name">pm.qms.organization.form</field>
        <field name="model">pm.qms.organization</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="active" optional="hide"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Processes">
                            <field name="process_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="process_owner_id"/>
                                    <field name="process_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_process_list" model="ir.ui.view">
        <field name="name">pm.qms.process.list</field>
        <field name="model">pm.qms.process</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="organization_id"/>
                <field name="process_owner_id"/>
                <field name="parent_id"/>
                <field name="process_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_process_form" model="ir.ui.view">
        <field name="name">pm.qms.process.form</field>
        <field name="model">pm.qms.process</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="organization_id"/>
                            <field name="parent_id"/>
                        </group>
                        <group string="Ownership">
                            <field name="process_owner_id"/>
                            <field name="department"/>
                            <field name="process_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Inputs and Outputs">
                            <group>
                                <field name="inputs"/>
                                <field name="outputs"/>
                            </group>
                        </page>
                        <page string="Controls">
                            <field name="control_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="state"/>
                                    <field name="owner_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_organization_search" model="ir.ui.view">
        <field name="name">pm.qms.organization.search</field>
        <field name="model">pm.qms.organization</field>
        <field name="arch" type="xml">
            <search string="Organizations">
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_pm_qms_process_search" model="ir.ui.view">
        <field name="name">pm.qms.process.search</field>
        <field name="model">pm.qms.process</field>
        <field name="arch" type="xml">
            <search string="Processes">
                <field name="name"/>
                <field name="code"/>
                <field name="organization_id"/>
                <field name="process_owner_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="group_organization" string="Organization" context="{'group_by': 'organization_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'process_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_pm_qms_organization" model="ir.actions.act_window">
        <field name="name">Organizations</field>
        <field name="res_model">pm.qms.organization</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_qms_organization_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No organizations yet</p>
            <p>Organizations define the company or business unit using Perfect Match QMS.</p>
        </field>
    </record>

    <record id="action_pm_qms_process" model="ir.actions.act_window">
        <field name="name">Processes</field>
        <field name="res_model">pm.qms.process</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_qms_process_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No processes yet</p>
            <p>Processes organize controls, ownership, inputs, outputs, and operational scope.</p>
        </field>
    </record>
</odoo>
