<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_organization_list" model="ir.ui.view">
        <field name="name">pm.qms.organization.list</field>
        <field name="model">pm.qms.organization</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_organization_form" model="ir.ui.view">
        <field name="name">pm.qms.organization.form</field>
        <field name="model">pm.qms.organization</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Processes">
                            <field name="process_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="process_owner_id"/>
                                    <field name="process_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_process_list" model="ir.ui.view">
        <field name="name">pm.qms.process.list</field>
        <field name="model">pm.qms.process</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="organization_id"/>
                <field name="process_owner_id"/>
                <field name="parent_id"/>
                <field name="process_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_process_form" model="ir.ui.view">
        <field name="name">pm.qms.process.form</field>
        <field name="model">pm.qms.process</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="organization_id"/>
                            <field name="parent_id"/>
                        </group>
                        <group string="Ownership">
                            <field name="process_owner_id"/>
                            <field name="department"/>
                            <field name="process_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Inputs and Outputs">
                            <group>
                                <field name="inputs"/>
                                <field name="outputs"/>
                            </group>
                        </page>
                        <page string="Controls">
                            <field name="control_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="state"/>
                                    <field name="owner_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_organization" model="ir.actions.act_window">
        <field name="name">Organizations</field>
        <field name="res_model">pm.qms.organization</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_pm_qms_process" model="ir.actions.act_window">
        <field name="name">Processes</field>
        <field name="res_model">pm.qms.process</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
