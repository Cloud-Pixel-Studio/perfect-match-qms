<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_activity_list" model="ir.ui.view">
        <field name="name">pm.qms.activity.list</field>
        <field name="model">pm.qms.activity</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="control_id"/>
                <field name="activity_kind" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                <field name="readiness_required" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                <field name="responsible_role"/>
                <field name="responsible_user_id"/>
                <field name="expected_output"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_activity_form" model="ir.ui.view">
        <field name="name">pm.qms.activity.form</field>
        <field name="model">pm.qms.activity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="definition_key" readonly="1"/>
                            <field name="control_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="responsible_role"/>
                            <field name="responsible_user_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="expected_output"/>
                        <field name="evidence_expectations"/>
                    </group>
                    <group string="Guided implementation semantics" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator">
                        <field name="objective"/>
                        <field name="why_it_matters"/>
                        <field name="implementation_steps"/>
                        <field name="success_criteria"/>
                        <field name="activity_kind"/>
                        <field name="readiness_required"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_activity" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">pm.qms.activity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
