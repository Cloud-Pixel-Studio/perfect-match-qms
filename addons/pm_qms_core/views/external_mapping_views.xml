<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_external_mapping_list" model="ir.ui.view">
        <field name="name">pm.qms.external.mapping.list</field>
        <field name="model">pm.qms.external.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="control_id"/>
                <field name="standard_name"/>
                <field name="edition"/>
                <field name="reference"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_external_mapping_form" model="ir.ui.view">
        <field name="name">pm.qms.external.mapping.form</field>
        <field name="model">pm.qms.external.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="control_id"/>
                            <field name="standard_name"/>
                            <field name="edition"/>
                        </group>
                        <group>
                            <field name="reference"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_external_mapping" model="ir.actions.act_window">
        <field name="name">External Mappings</field>
        <field name="res_model">pm.qms.external.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
