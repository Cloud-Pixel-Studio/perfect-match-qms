<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_control_list" model="ir.ui.view">
        <field name="name">pm.qms.control.list</field>
        <field name="model">pm.qms.control</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-muted="state == 'retired'">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="process_id"/>
                <field name="owner_id"/>
                <field name="state"/>
                <field name="external_mapping_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_control_form" model="ir.ui.view">
        <field name="name">pm.qms.control.form</field>
        <field name="model">pm.qms.control</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" invisible="state != 'draft'"/>
                    <button name="action_retire" type="object" string="Retire" invisible="state != 'active'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,retired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Perfect Match control title"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="category"/>
                            <field name="active" optional="hide"/>
                        </group>
                        <group string="Implementation">
                            <field name="process_id"/>
                            <field name="owner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Objective">
                            <field name="objective"/>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Guidance">
                            <group>
                                <field name="guidance_purpose"/>
                                <field name="guidance_why"/>
                                <field name="implementation_guidance"/>
                                <field name="recommended_steps"/>
                                <field name="recommended_tools"/>
                                <field name="evidence_guidance"/>
                                <field name="practical_notes"/>
                            </group>
                        </page>
                        <page string="Activities">
                            <field name="implementation_activity_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="responsible_role"/>
                                    <field name="responsible_user_id"/>
                                    <field name="expected_output"/>
                                    <field name="active" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Evidence">
                            <field name="evidence_requirement_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="evidence_type"/>
                                    <field name="mandatory"/>
                                    <field name="active" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="External References">
                            <field name="external_mapping_ids">
                                <list editable="bottom">
                                    <field name="standard_name"/>
                                    <field name="edition"/>
                                    <field name="reference"/>
                                    <field name="note"/>
                                    <field name="active" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_control_search" model="ir.ui.view">
        <field name="name">pm.qms.control.search</field>
        <field name="model">pm.qms.control</field>
        <field name="arch" type="xml">
            <search string="Framework Controls">
                <field name="name"/>
                <field name="code"/>
                <field name="process_id"/>
                <field name="owner_id"/>
                <filter name="active_controls" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="draft_controls" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                <filter name="group_process" string="Process" context="{'group_by': 'process_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_pm_qms_control" model="ir.actions.act_window">
        <field name="name">Framework Controls</field>
        <field name="res_model">pm.qms.control</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_qms_control_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No framework controls yet</p>
            <p>Framework controls contain Perfect Match proprietary implementation guidance, activities, and evidence requirements.</p>
        </field>
    </record>
</odoo>
