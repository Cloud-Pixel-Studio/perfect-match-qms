<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_process_tree" model="ir.ui.view">
        <field name="name">pm.qms.process.tree</field>
        <field name="model">pm.qms.process</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="parent_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_process_form" model="ir.ui.view">
        <field name="name">pm.qms.process.form</field>
        <field name="model">pm.qms.process</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Controls">
                            <field name="control_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="owner_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_process" model="ir.actions.act_window">
        <field name="name">QMS Processes</field>
        <field name="res_model">pm.qms.process</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
