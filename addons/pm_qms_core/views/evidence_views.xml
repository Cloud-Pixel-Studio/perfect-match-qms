<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_evidence_requirement_list" model="ir.ui.view">
        <field name="name">pm.qms.evidence.requirement.list</field>
        <field name="model">pm.qms.evidence.requirement</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="control_id"/>
                <field name="evidence_type"/>
                <field name="mandatory"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_evidence_requirement_form" model="ir.ui.view">
        <field name="name">pm.qms.evidence.requirement.form</field>
        <field name="model">pm.qms.evidence.requirement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="control_id"/>
                            <field name="evidence_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="mandatory"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_evidence_requirement" model="ir.actions.act_window">
        <field name="name">Evidence Requirements</field>
        <field name="res_model">pm.qms.evidence.requirement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
