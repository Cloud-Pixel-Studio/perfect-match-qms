<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_evidence_requirement_list" model="ir.ui.view">
        <field name="name">pm.qms.evidence.requirement.list</field>
        <field name="model">pm.qms.evidence.requirement</field>
        <field name="arch" type="xml">
            <list decoration-info="mandatory" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="definition_key" optional="hide"/>
                <field name="name"/>
                <field name="control_id"/>
                <field name="evidence_type"/>
                <field name="mandatory"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_evidence_requirement_form" model="ir.ui.view">
        <field name="name">pm.qms.evidence.requirement.form</field>
        <field name="model">pm.qms.evidence.requirement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="definition_key" readonly="1"/>
                            <field name="name"/>
                            <field name="control_id"/>
                            <field name="evidence_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="mandatory"/>
                            <field name="active" optional="hide"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="acceptance_criteria" placeholder="One observable condition per line."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_evidence_requirement_search" model="ir.ui.view">
        <field name="name">pm.qms.evidence.requirement.search</field>
        <field name="model">pm.qms.evidence.requirement</field>
        <field name="arch" type="xml">
            <search string="Evidence Requirements">
                <field name="name"/>
                <field name="control_id"/>
                <filter name="mandatory" string="Mandatory" domain="[('mandatory', '=', True)]"/>
                <filter name="group_type" string="Type" context="{'group_by': 'evidence_type'}"/>
                <filter name="group_control" string="Control" context="{'group_by': 'control_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_pm_qms_evidence_requirement" model="ir.actions.act_window">
        <field name="name">Evidence Requirements</field>
        <field name="res_model">pm.qms.evidence.requirement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_qms_evidence_requirement_search"/>
    </record>
</odoo>
