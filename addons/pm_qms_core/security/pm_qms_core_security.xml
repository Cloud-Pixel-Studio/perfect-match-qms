<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_pm_qms_user" model="res.groups">
        <field name="name">Perfect Match QMS User</field>
    </record>

    <record id="group_pm_qms_manager" model="res.groups">
        <field name="name">Perfect Match QMS Manager</field>
        <field name="implied_ids" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>

    <record id="rule_pm_qms_process_company" model="ir.rule">
        <field name="name">Perfect Match QMS process company boundary</field>
        <field name="model_id" ref="model_pm_qms_process"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>

    <record id="rule_pm_qms_control_company" model="ir.rule">
        <field name="name">Perfect Match QMS control company boundary</field>
        <field name="model_id" ref="model_pm_qms_control"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>

    <record id="rule_pm_qms_implementation_activity_company" model="ir.rule">
        <field name="name">Perfect Match QMS activity company boundary</field>
        <field name="model_id" ref="model_pm_qms_implementation_activity"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>

    <record id="rule_pm_qms_evidence_requirement_company" model="ir.rule">
        <field name="name">Perfect Match QMS evidence requirement company boundary</field>
        <field name="model_id" ref="model_pm_qms_evidence_requirement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>

    <record id="rule_pm_qms_external_mapping_company" model="ir.rule">
        <field name="name">Perfect Match QMS external mapping company boundary</field>
        <field name="model_id" ref="model_pm_qms_external_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('pm_qms_core.group_pm_qms_user'))]"/>
    </record>
</odoo>
