<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pm_qms" model="ir.module.category">
        <field name="name">Perfect Match QMS</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_pm_qms" model="res.groups.privilege">
        <field name="name">Perfect Match QMS</field>
        <field name="category_id" ref="pm_qms_core.module_category_pm_qms"/>
        <field name="sequence">10</field>
