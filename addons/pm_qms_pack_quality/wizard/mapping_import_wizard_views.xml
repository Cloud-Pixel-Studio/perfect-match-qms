<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_mapping_import_wizard_form" model="ir.ui.view">
        <field name="name">pm.qms.mapping.import.wizard.form</field>
        <field name="model">pm.qms.mapping.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="mapping_profile_id"/>
                        <field name="csv_file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_mapping_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Mapping Metadata</field>
        <field name="res_model">pm.qms.mapping.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
