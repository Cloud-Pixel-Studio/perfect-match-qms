<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_iso9001_demo_preview_pack_form" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.demo.preview.pack.form</field>
        <field name="model">pm.qms.framework.pack</field>
        <field name="inherit_id" ref="pm_qms_implementation.view_pm_qms_framework_pack_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_activate']" position="attributes">
                <attribute name="invisible">state != 'draft' or code == 'PM-QMS-ISO9001-2026'</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_activate']" position="after">
                <button name="action_enable_demo_preview" type="object" string="Enable Demo Preview"
                        invisible="state != 'draft' or code != 'PM-QMS-ISO9001-2026'"
                        groups="pm_qms_core.group_pm_qms_administrator"/>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,demo_preview,active,retired</attribute>
            </xpath>
            <xpath expr="//sheet/group" position="before">
                <div class="alert alert-warning" role="alert" invisible="state != 'demo_preview'">
                    Demo Preview is for isolated product testing only. This pack and its reference mappings
                    have not passed independent practitioner review and are not an approved customer release.
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_pm_qms_iso9001_profile_list" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.mapping.profile.list</field>
        <field name="model">pm.qms.mapping.profile</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="standard_name"/>
                <field name="edition"/>
                <field name="publisher"/>
                <field name="state"/>
                <field name="total_control_count"/>
                <field name="mapped_control_count"/>
                <field name="mapping_completeness_percent"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_iso9001_profile_form" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.mapping.profile.form</field>
        <field name="model">pm.qms.mapping.profile</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="standard_name"/>
                            <field name="edition"/>
                            <field name="publisher"/>
                            <field name="state"/>
                        </group>
                        <group string="Coverage">
                            <field name="total_control_count"/>
                            <field name="mapped_control_count"/>
                            <field name="unmapped_control_count"/>
                            <field name="pending_mapping_count"/>
                            <field name="rejected_mapping_count"/>
                            <field name="mapping_completeness_percent"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reference Mapping">
                            <field name="mapping_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="control_id"/>
                                    <field name="reference"/>
                                    <field name="mapping_type"/>
                                    <field name="review_status"/>
                                    <field name="reviewed_by_id"/>
                                    <field name="review_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_iso9001_transition_scenario_list" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.transition.scenario.list</field>
        <field name="model">pm.qms.iso9001.transition.scenario</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="sequence"/>
                <field name="code"/>
                <field name="name"/>
                <field name="scenario_type"/>
                <field name="source_edition"/>
                <field name="target_edition"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_iso9001_transition_scenario_form" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.transition.scenario.form</field>
        <field name="model">pm.qms.iso9001.transition.scenario</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_create_gap_assessment" type="object" string="Start Gap Assessment" class="btn-primary" invisible="state != 'active' or not active" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="scenario_type"/>
                            <field name="source_edition"/>
                            <field name="target_edition"/>
                        </group>
                        <group>
                            <field name="profile_id"/>
                            <field name="company_id"/>
                            <field name="state"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scenario Definition">
                            <group>
                                <field name="objective"/>
                                <field name="entry_conditions"/>
                                <field name="required_outputs"/>
                                <field name="migration_policy"/>
                            </group>
                        </page>
                        <page string="Gap Assessments">
                            <field name="assessment_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="assessment_date"/>
                                    <field name="assessor_id"/>
                                    <field name="state"/>
                                    <field name="readiness_percent"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_iso9001_gap_assessment_list" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.gap.assessment.list</field>
        <field name="model">pm.qms.iso9001.gap.assessment</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="code"/>
                <field name="name"/>
                <field name="scenario_id"/>
                <field name="source_edition_snapshot"/>
                <field name="target_edition_snapshot"/>
                <field name="assessment_date"/>
                <field name="state"/>
                <field name="readiness_percent"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_iso9001_gap_assessment_form" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.gap.assessment.form</field>
        <field name="model">pm.qms.iso9001.gap.assessment</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state != 'in_progress'" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'in_progress')" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_generate_transition_plan" type="object" string="Generate Transition Plan" class="btn-primary" invisible="state != 'completed' or (partial_area_count == 0 and gap_area_count == 0)" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_prepare_readiness_review" type="object" string="Prepare Readiness Review" class="btn-primary" invisible="state != 'completed' or (transition_action_count == 0 and (partial_area_count > 0 or gap_area_count > 0 or not implementation_project_id))" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name" readonly="state == 'completed'"/>
                            <field name="scenario_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="source_profile_id" readonly="state != 'draft'"/>
                            <field name="implementation_project_id" readonly="state != 'draft'"/>
                            <field name="target_profile_id" readonly="1"/>
                            <field name="assessment_date" readonly="state == 'completed'"/>
                            <field name="assessor_id" readonly="state == 'completed'"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <field name="total_area_count"/>
                        <field name="conforming_area_count"/>
                        <field name="partial_area_count"/>
                        <field name="gap_area_count"/>
                        <field name="not_applicable_area_count"/>
                        <field name="readiness_percent"/>
                        <field name="transition_action_count"/>
                        <field name="readiness_review_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Assessment Areas">
                            <field name="line_ids" readonly="state != 'in_progress'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="focus_name_snapshot"/>
                                    <field name="status"/>
                                    <field name="evidence_summary"/>
                                    <field name="gap_description"/>
                                    <field name="disposition_rationale"/>
                                    <field name="action_plan"/>
                                    <field name="responsible_id"/>
                                    <field name="target_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Transition Actions">
                            <field name="transition_action_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="source_status_snapshot"/>
                                    <field name="owner_id"/>
                                    <field name="priority"/>
                                    <field name="target_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Conclusion">
                            <field name="conclusion" readonly="state == 'completed'"/>
                            <group invisible="state != 'completed'">
                                <field name="completed_by_id"/>
                                <field name="completed_date"/>
                                <field name="source_edition_snapshot"/>
                                <field name="target_edition_snapshot"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_pm_qms_iso9001_transition_action_list" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.transition.action.list</field>
        <field name="model">pm.qms.iso9001.transition.action</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="code"/>
                <field name="name"/>
                <field name="assessment_id"/>
                <field name="source_status_snapshot"/>
                <field name="owner_id"/>
                <field name="priority"/>
                <field name="target_date"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_iso9001_transition_action_form" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.transition.action.form</field>
        <field name="model">pm.qms.iso9001.transition.action</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_submit_verification" type="object" string="Submit for Verification" class="btn-primary" invisible="state not in ('draft', 'in_progress')" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_complete" type="object" string="Verify and Complete" class="btn-primary" invisible="state != 'verification'" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed', 'cancelled')" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,verification,completed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name" readonly="state == 'completed'"/>
                            <field name="assessment_id"/>
                            <field name="assessment_line_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="owner_id" readonly="state == 'completed'"/>
                            <field name="priority" readonly="state == 'completed'"/>
                            <field name="target_date" readonly="state == 'completed'"/>
                            <field name="implementation_project_id" domain="[('company_id', '=', company_id)]" readonly="state == 'completed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transition Requirement">
                            <group>
                                <field name="focus_code_snapshot"/>
                                <field name="focus_name_snapshot"/>
                                <field name="source_status_snapshot"/>
                                <field name="gap_description_snapshot"/>
                                <field name="action_plan_snapshot"/>
                            </group>
                        </page>
                        <page string="Execution and Verification">
                            <field name="progress_notes" readonly="state == 'completed'"/>
                            <field name="completion_summary" readonly="state == 'completed'"/>
                            <field name="verification_evidence" readonly="state == 'completed'"/>
                            <group invisible="state not in ('verification', 'completed')">
                                <field name="submitted_by_id"/>
                                <field name="submitted_date"/>
                                <field name="verified_by_id" invisible="state != 'completed'"/>
                                <field name="verified_date" invisible="state != 'completed'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_iso9001_transition_actions" model="ir.actions.act_window">
        <field name="name">Transition Actions</field>
        <field name="res_model">pm.qms.iso9001.transition.action</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pm_qms_iso9001_transition_review_list" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.transition.review.list</field>
        <field name="model">pm.qms.iso9001.transition.review</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="code"/>
                <field name="name"/>
                <field name="assessment_id"/>
                <field name="implementation_project_id"/>
                <field name="reviewer_id"/>
                <field name="decision"/>
                <field name="open_action_count_snapshot"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_iso9001_transition_review_form" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.transition.review.form</field>
        <field name="model">pm.qms.iso9001.transition.review</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state not in ('draft', 'returned')" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_approve" type="object" string="Approve Decision" class="btn-primary" invisible="state != 'submitted'" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_return" type="object" string="Return" invisible="state != 'submitted'" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_prepare_migration_package" type="object" string="Prepare Migration Package" class="btn-primary" invisible="state != 'approved' or decision != 'internal_review' or not source_edition_snapshot or source_edition_snapshot == target_edition_snapshot" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,returned,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name" readonly="state == 'approved'"/>
                            <field name="assessment_id"/>
                            <field name="implementation_project_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="review_date" readonly="state in ('submitted', 'approved')"/>
                            <field name="reviewer_id" domain="[('company_ids', 'in', company_id)]" readonly="state in ('submitted', 'approved')"/>
                            <field name="decision" readonly="state in ('submitted', 'approved')"/>
                            <field name="source_edition_snapshot"/>
                            <field name="target_edition_snapshot"/>
                            <field name="migration_package_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Submitted Action Snapshot" invisible="state == 'draft'">
                        <field name="total_action_count_snapshot"/>
                        <field name="completed_action_count_snapshot"/>
                        <field name="open_action_count_snapshot"/>
                    </group>
                    <notebook>
                        <page string="Review">
                            <field name="review_basis" readonly="state in ('submitted', 'approved')"/>
                            <field name="residual_risk_summary" readonly="state in ('submitted', 'approved')"/>
                            <field name="decision_notes" readonly="state in ('submitted', 'approved')"/>
                            <field name="return_reason" readonly="state != 'submitted'"/>
                        </page>
                        <page string="Approval History">
                            <group>
                                <field name="submitted_by_id"/>
                                <field name="submitted_date"/>
                                <field name="approved_by_id"/>
                                <field name="approved_date"/>
                                <field name="returned_by_id"/>
                                <field name="returned_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_iso9001_migration_package_list" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.migration.package.list</field>
        <field name="model">pm.qms.iso9001.migration.package</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="code"/>
                <field name="name"/>
                <field name="package_version"/>
                <field name="readiness_review_id"/>
                <field name="implementation_project_id"/>
                <field name="reviewer_id"/>
                <field name="manifest_sha256"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_iso9001_migration_package_form" model="ir.ui.view">
        <field name="name">pm.qms.iso9001.migration.package.form</field>
        <field name="model">pm.qms.iso9001.migration.package</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_run_preflight" type="object" string="Run Preflight" class="btn-primary" invisible="state not in ('draft', 'returned')" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'preflight_passed'" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_approve" type="object" string="Approve Package" class="btn-primary" invisible="state != 'submitted'" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_return" type="object" string="Return" invisible="state != 'submitted'" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <button name="action_void" type="object" string="Void" invisible="state in ('approved', 'voided')" groups="pm_qms_core.group_pm_qms_manager,pm_qms_core.group_pm_qms_administrator"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,preflight_passed,submitted,returned,approved,voided"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name" readonly="state in ('submitted', 'approved', 'voided')"/>
                            <field name="package_version" readonly="state in ('submitted', 'approved', 'voided')"/>
                            <field name="readiness_review_id"/>
                            <field name="assessment_id"/>
                            <field name="implementation_project_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="source_edition_snapshot"/>
                            <field name="target_edition_snapshot"/>
                            <field name="reviewer_id" domain="[('company_ids', 'in', company_id)]" readonly="state in ('submitted', 'approved', 'voided')"/>
                            <field name="execution_window" readonly="state in ('submitted', 'approved', 'voided')"/>
                            <field name="manifest_sha256"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scope and Compatibility">
                            <field name="migration_scope" readonly="state in ('submitted', 'approved', 'voided')"/>
                            <field name="source_inventory" readonly="state in ('submitted', 'approved', 'voided')"/>
                            <field name="compatibility_notes" readonly="state in ('submitted', 'approved', 'voided')"/>
                            <field name="dry_run_plan" readonly="state in ('submitted', 'approved', 'voided')"/>
                        </page>
                        <page string="Backup and Rollback">
                            <group>
                                <field name="backup_reference" readonly="state in ('submitted', 'approved', 'voided')"/>
                                <field name="backup_sha256" readonly="state in ('submitted', 'approved', 'voided')"/>
                                <field name="backup_verified" readonly="state in ('submitted', 'approved', 'voided')"/>
                            </group>
                            <field name="rollback_plan" readonly="state in ('submitted', 'approved', 'voided')"/>
                            <field name="rollback_acceptance_criteria" readonly="state in ('submitted', 'approved', 'voided')"/>
                        </page>
                        <page string="Approval History">
                            <group>
                                <field name="preflight_by_id"/>
                                <field name="preflight_date"/>
                                <field name="submitted_by_id"/>
                                <field name="submitted_date"/>
                                <field name="approved_by_id"/>
                                <field name="approved_date"/>
                                <field name="returned_by_id"/>
                                <field name="returned_date"/>
                            </group>
                            <field name="return_reason" readonly="state != 'submitted'"/>
                            <field name="void_reason" readonly="state in ('approved', 'voided')"/>
                        </page>
                        <page string="Immutable Manifest" invisible="not manifest_snapshot">
                            <field name="manifest_snapshot" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

