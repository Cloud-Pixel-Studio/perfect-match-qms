    <record id="action_pm_qms_iso9001_overview" model="ir.actions.act_window">
        <field name="name">ISO 9001 Profiles</field>
        <field name="res_model">pm.qms.mapping.profile</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_pm_qms_iso9001_profile_list"/>
