<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_pm_qms_person" model="ir.sequence">
        <field name="name">Perfect Match QMS Person</field>
        <field name="code">pm.qms.person</field>
        <field name="prefix">PM-PER-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_pm_qms_qualification_expiration" model="ir.cron">
        <field name="name">Perfect Match QMS qualification expiration reminders</field>
        <field name="model_id" ref="model_pm_qms_qualification_record"/>
        <field name="state">code</field>
        <field name="code">model.cron_create_expiration_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_pm_qms_document_acknowledgment_overdue" model="ir.cron">
        <field name="name">Perfect Match QMS overdue document acknowledgment reminders</field>
        <field name="model_id" ref="model_pm_qms_document_acknowledgment"/>
        <field name="state">code</field>
        <field name="code">model.cron_create_overdue_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
