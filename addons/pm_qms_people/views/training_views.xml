<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_training_course_list" model="ir.ui.view">
        <field name="name">pm.qms.training.course.list</field>
        <field name="model">pm.qms.training.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="training_type"/>
                <field name="delivery_source"/>
                <field name="validity_months"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_training_course_form" model="ir.ui.view">
        <field name="name">pm.qms.training.course.form</field>
        <field name="model">pm.qms.training.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="training_type"/>
                            <field name="delivery_source"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="validity_months"/>
                            <field name="competency_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_training_course" model="ir.actions.act_window">
        <field name="name">Training Definitions</field>
        <field name="res_model">pm.qms.training.course</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pm_qms_training_event_list" model="ir.ui.view">
        <field name="name">pm.qms.training.event.list</field>
        <field name="model">pm.qms.training.event</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'">
                <field name="event_date"/>
                <field name="name"/>
                <field name="course_id"/>
                <field name="organization_id"/>
                <field name="delivery_method"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_training_event_form" model="ir.ui.view">
        <field name="name">pm.qms.training.event.form</field>
        <field name="model">pm.qms.training.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="course_id"/>
                            <field name="organization_id"/>
                            <field name="event_date"/>
                        </group>
                        <group>
                            <field name="instructor"/>
                            <field name="provider"/>
                            <field name="delivery_method"/>
                            <field name="location"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Training Records">
                            <field name="participant_record_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_training_event" model="ir.actions.act_window">
        <field name="name">Training Events</field>
        <field name="res_model">pm.qms.training.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pm_qms_training_record_list" model="ir.ui.view">
        <field name="name">pm.qms.training.record.list</field>
        <field name="model">pm.qms.training.record</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed'" decoration-warning="state in ('required', 'scheduled')" decoration-danger="state in ('failed', 'expired', 'overdue')">
                <field name="person_id"/>
                <field name="course_id"/>
                <field name="due_date"/>
                <field name="completion_date"/>
                <field name="result"/>
                <field name="valid_until"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_training_record_form" model="ir.ui.view">
        <field name="name">pm.qms.training.record.form</field>
        <field name="model">pm.qms.training.record</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="person_id"/>
                            <field name="course_id"/>
                            <field name="event_id"/>
                            <field name="requirement_id"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="completion_date"/>
                            <field name="result"/>
                            <field name="valid_until"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Effectiveness">
                        <field name="effectiveness_review_required"/>
                        <field name="effectiveness_reviewer_id"/>
                        <field name="effectiveness_review_date"/>
                        <field name="effectiveness_result"/>
                        <field name="effectiveness_notes"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_training_record" model="ir.actions.act_window">
        <field name="name">Training Records</field>
        <field name="res_model">pm.qms.training.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
