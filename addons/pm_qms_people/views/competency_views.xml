<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_competency_list" model="ir.ui.view">
        <field name="name">pm.qms.competency.list</field>
        <field name="model">pm.qms.competency</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_competency_form" model="ir.ui.view">
        <field name="name">pm.qms.competency.form</field>
        <field name="model">pm.qms.competency</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_competency" model="ir.actions.act_window">
        <field name="name">Competencies</field>
        <field name="res_model">pm.qms.competency</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pm_qms_competency_assessment_list" model="ir.ui.view">
        <field name="name">pm.qms.competency.assessment.list</field>
        <field name="model">pm.qms.competency.assessment</field>
        <field name="arch" type="xml">
            <list decoration-success="result == 'competent'" decoration-danger="result == 'gap'">
                <field name="person_id"/>
                <field name="competency_id"/>
                <field name="assessment_date"/>
                <field name="result"/>
                <field name="valid_until"/>
                <field name="assessor_id"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_competency_assessment_form" model="ir.ui.view">
        <field name="name">pm.qms.competency.assessment.form</field>
        <field name="model">pm.qms.competency.assessment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="person_id"/>
                            <field name="competency_id"/>
                            <field name="assessment_date"/>
                            <field name="result"/>
                        </group>
                        <group>
                            <field name="assessor_id"/>
                            <field name="level"/>
                            <field name="valid_until"/>
                            <field name="evidence_id"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_competency_assessment" model="ir.actions.act_window">
        <field name="name">Competency Assessments</field>
        <field name="res_model">pm.qms.competency.assessment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pm_qms_competency_matrix_line_list" model="ir.ui.view">
        <field name="name">pm.qms.competency.matrix.line.list</field>
        <field name="model">pm.qms.competency.matrix.line</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'competent'" decoration-warning="status == 'not_assessed'" decoration-danger="status in ('gap', 'expired')">
                <field name="person_id"/>
                <field name="role_id"/>
                <field name="competency_id"/>
                <field name="status"/>
                <field name="latest_assessment_id"/>
                <field name="assessment_valid_until"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_competency_matrix_line_pivot" model="ir.ui.view">
        <field name="name">pm.qms.competency.matrix.line.pivot</field>
        <field name="model">pm.qms.competency.matrix.line</field>
        <field name="arch" type="xml">
            <pivot string="Competency Matrix">
                <field name="person_id" type="row"/>
                <field name="competency_id" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_pm_qms_competency_matrix" model="ir.actions.act_window">
        <field name="name">Competency Matrix</field>
        <field name="res_model">pm.qms.competency.matrix.line</field>
        <field name="view_mode">list,pivot</field>
    </record>
</odoo>
