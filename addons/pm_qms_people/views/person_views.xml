<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_person_list" model="ir.ui.view">
        <field name="name">pm.qms.person.list</field>
        <field name="model">pm.qms.person</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="organization_id"/>
                <field name="site_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="competency_gap_count"/>
                <field name="overdue_training_count"/>
                <field name="expiring_qualification_count"/>
                <field name="pending_acknowledgment_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_person_form" model="ir.ui.view">
        <field name="name">pm.qms.person.form</field>
        <field name="model">pm.qms.person</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_competency_matrix" type="object" string="Sync Matrix"/>
                    <button name="action_sync_acknowledgments" type="object" string="Sync Acknowledgments"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="organization_id"/>
                            <field name="site_id"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id"/>
                            <field name="competency_gap_count"/>
                            <field name="pending_acknowledgment_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="QMS Roles">
                            <field name="role_assignment_ids">
                                <list editable="bottom">
                                    <field name="role_id"/>
                                    <field name="effective_date"/>
                                    <field name="end_date"/>
                                    <field name="active"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Competency Assessments">
                            <field name="competency_assessment_ids"/>
                        </page>
                        <page string="Training">
                            <field name="training_record_ids"/>
                        </page>
                        <page string="Qualifications">
                            <field name="qualification_record_ids"/>
                        </page>
                        <page string="Document Acknowledgments">
                            <field name="acknowledgment_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pm_qms_person_search" model="ir.ui.view">
        <field name="name">pm.qms.person.search</field>
        <field name="model">pm.qms.person</field>
        <field name="arch" type="xml">
            <search string="QMS People">
                <field name="name"/>
                <field name="code"/>
                <field name="organization_id"/>
                <field name="site_id"/>
                <field name="user_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="group_org" string="Organization" context="{'group_by': 'organization_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_pm_qms_person" model="ir.actions.act_window">
        <field name="name">People</field>
        <field name="res_model">pm.qms.person</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pm_qms_person_search"/>
    </record>
</odoo>
