<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_qualification_type_list" model="ir.ui.view">
        <field name="name">pm.qms.qualification.type.list</field>
        <field name="model">pm.qms.qualification.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="expiring_soon_days"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_qualification_type_form" model="ir.ui.view">
        <field name="name">pm.qms.qualification.type.form</field>
        <field name="model">pm.qms.qualification.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="expiring_soon_days"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_qualification_type" model="ir.actions.act_window">
        <field name="name">Qualification Types</field>
        <field name="res_model">pm.qms.qualification.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pm_qms_qualification_record_list" model="ir.ui.view">
        <field name="name">pm.qms.qualification.record.list</field>
        <field name="model">pm.qms.qualification.record</field>
        <field name="arch" type="xml">
            <list decoration-success="status in ('valid', 'no_expiration')" decoration-warning="status == 'expiring'" decoration-danger="status == 'expired'">
                <field name="person_id"/>
                <field name="qualification_type_id"/>
                <field name="identifier"/>
                <field name="issuer"/>
                <field name="issue_date"/>
                <field name="expiration_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_qualification_record_form" model="ir.ui.view">
        <field name="name">pm.qms.qualification.record.form</field>
        <field name="model">pm.qms.qualification.record</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="person_id"/>
                            <field name="qualification_type_id"/>
                            <field name="identifier"/>
                            <field name="issuer"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiration_date"/>
                            <field name="status"/>
                            <field name="attachment_id"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_qualification_record" model="ir.actions.act_window">
        <field name="name">Qualifications</field>
        <field name="res_model">pm.qms.qualification.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
