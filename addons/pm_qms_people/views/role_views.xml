<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_role_list" model="ir.ui.view">
        <field name="name">pm.qms.role.list</field>
        <field name="model">pm.qms.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="organization_id"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pm_qms_role_form" model="ir.ui.view">
        <field name="name">pm.qms.role.form</field>
        <field name="model">pm.qms.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id"/>
                            <field name="organization_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Competency Requirements">
                            <field name="competency_requirement_ids">
                                <list editable="bottom">
                                    <field name="competency_id"/>
                                    <field name="required"/>
                                    <field name="valid_months"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Document Acknowledgment Requirements">
                            <field name="document_ack_requirement_ids">
                                <list editable="bottom">
                                    <field name="document_id"/>
                                    <field name="due_within_days"/>
                                    <field name="active"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Training Requirements">
                            <field name="training_requirement_ids">
                                <list editable="bottom">
                                    <field name="course_id"/>
                                    <field name="competency_id"/>
                                    <field name="due_within_days"/>
                                    <field name="required"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="People">
                            <field name="person_assignment_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_qms_role" model="ir.actions.act_window">
        <field name="name">QMS Roles</field>
        <field name="res_model">pm.qms.role</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
