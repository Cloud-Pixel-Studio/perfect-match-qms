<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_supplier_issue_list" model="ir.ui.view"><field name="name">pm.qms.supplier.issue.list</field><field name="model">pm.qms.supplier.issue</field><field name="arch" type="xml"><list decoration-danger="severity == 'critical'" decoration-success="state == 'closed'" decoration-muted="state == 'cancelled'"><field name="code"/><field name="name"/><field name="supplier_id"/><field name="issue_date"/><field name="severity"/><field name="scar_required"/><field name="owner_id"/><field name="state"/></list></field></record>
    <record id="view_pm_qms_supplier_issue_form" model="ir.ui.view"><field name="name">pm.qms.supplier.issue.form</field><field name="model">pm.qms.supplier.issue</field><field name="arch" type="xml">
        <form>
            <header>
                <button name="action_review" type="object" string="Review" invisible="state != 'new'"/>
                <button name="action_start_containment" type="object" string="Containment" invisible="state not in ('new', 'review')"/>
                <button name="action_complete_containment" type="object" string="Complete Containment" invisible="state != 'containment'"/>
                <button name="action_create_ncr" type="object" string="Create / Open NCR" class="btn-secondary"/>
                <button name="action_create_scar" type="object" string="Create / Open SCAR" class="btn-secondary"/>
                <button name="action_move_to_scar" type="object" string="SCAR" invisible="state != 'review'"/>
                <button name="action_start_verification" type="object" string="Verify" invisible="state != 'scar'"/>
                <button name="action_close" type="object" string="Close" invisible="state != 'verification'"/>
                <button name="action_cancel" type="object" string="Cancel" invisible="state in ('closed', 'cancelled')"/>
                <field name="state" widget="statusbar" statusbar_visible="new,review,containment,scar,verification,closed"/>
            </header>
            <sheet>
                <div class="oe_title"><h1><field name="name"/></h1><h2><field name="code"/></h2></div>
                <group><group><field name="supplier_id"/><field name="issue_date"/><field name="supplier_reference"/><field name="purchase_reference"/><field name="severity"/><field name="owner_id"/></group><group><field name="organization_id"/><field name="process_id"/><field name="company_id" groups="base.group_multi_company"/><field name="scar_required"/><field name="ncr_id"/><field name="scar_id"/><field name="capa_id"/><field name="eight_d_id"/></group></group>
                <notebook>
                    <page string="Issue"><field name="description"/><group><field name="product_reference"/><field name="lot_serial_reference"/><field name="quantity_affected"/></group></page>
                    <page string="Containment"><field name="containment_required"/><field name="containment_owner_id"/><field name="containment_due_date"/><field name="containment_completed_date"/><field name="containment_action"/></page>
                    <page string="Evidence"><field name="related_document_ids"/><field name="related_evidence_ids"/><field name="attachment_ids" widget="many2many_binary"/></page>
                    <page string="Closure"><field name="closure_notes"/></page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field></record>
    <record id="view_pm_qms_supplier_issue_search" model="ir.ui.view"><field name="name">pm.qms.supplier.issue.search</field><field name="model">pm.qms.supplier.issue</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="supplier_id"/><filter name="open" string="Open" domain="[('state','not in',('closed','cancelled'))]"/><filter name="scar_required" string="SCAR Required" domain="[('scar_required','=',True)]"/><filter name="group_supplier" string="Supplier" context="{'group_by':'supplier_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field></record>
    <record id="action_pm_qms_supplier_issue" model="ir.actions.act_window"><field name="name">Supplier Issues</field><field name="res_model">pm.qms.supplier.issue</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_pm_qms_supplier_issue_search"/></record>
</odoo>
