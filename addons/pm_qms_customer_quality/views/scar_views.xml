<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_scar_list" model="ir.ui.view"><field name="name">pm.qms.scar.list</field><field name="model">pm.qms.scar</field><field name="arch" type="xml"><list decoration-danger="is_overdue" decoration-warning="state == 'returned'" decoration-success="state == 'closed'" decoration-muted="state == 'cancelled'"><field name="code"/><field name="name"/><field name="supplier_id"/><field name="issue_date"/><field name="response_due_date"/><field name="is_overdue"/><field name="effectiveness_result"/><field name="state"/></list></field></record>
    <record id="view_pm_qms_scar_form" model="ir.ui.view"><field name="name">pm.qms.scar.form</field><field name="model">pm.qms.scar</field><field name="arch" type="xml">
        <form>
            <header>
                <button name="action_issue" type="object" string="Issue" invisible="state != 'draft'"/>
                <button name="action_record_response" type="object" string="Record Response" invisible="state not in ('issued', 'returned')"/>
                <button name="action_return_for_revision" type="object" string="Return" invisible="state != 'response_received'"/>
                <button name="action_accept_response" type="object" string="Accept" invisible="state != 'response_received'"/>
                <button name="action_create_capa" type="object" string="Create / Open CAPA" class="btn-secondary"/>
                <button name="action_create_eight_d" type="object" string="Create / Open 8D" class="btn-secondary"/>
                <button name="action_start_effectiveness" type="object" string="Effectiveness" invisible="state != 'accepted'"/>
                <button name="action_mark_effective" type="object" string="Accept Effectiveness" invisible="state != 'effectiveness_review'"/>
                <button name="action_close" type="object" string="Close" invisible="state != 'effectiveness_review'"/>
                <button name="action_cancel" type="object" string="Cancel" invisible="state in ('closed', 'cancelled')"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,issued,response_received,returned,accepted,effectiveness_review,closed"/>
            </header>
            <sheet>
                <div class="oe_title"><h1><field name="name"/></h1><h2><field name="code"/></h2></div>
                <group><group><field name="supplier_id"/><field name="supplier_reference"/><field name="issue_date"/><field name="response_due_date"/><field name="supplier_response_date"/><field name="is_overdue"/><field name="owner_id"/></group><group><field name="organization_id"/><field name="process_id"/><field name="company_id" groups="base.group_multi_company"/><field name="supplier_issue_id"/><field name="ncr_id"/><field name="capa_id"/><field name="eight_d_id"/></group></group>
                <notebook>
                    <page string="Issue"><field name="description"/><field name="containment_required"/></page>
                    <page string="Supplier Response"><field name="supplier_containment"/><field name="supplier_root_cause"/><field name="supplier_corrective_action"/><field name="response_line_ids"><list><field name="revision"/><field name="response_date"/><field name="submitted_by"/><field name="review_result"/></list></field></page>
                    <page string="Internal Review"><field name="internal_review_notes"/></page>
                    <page string="Effectiveness"><field name="effectiveness_review_date"/><field name="effectiveness_result"/><field name="effectiveness_notes"/></page>
                    <page string="Evidence"><field name="related_document_ids"/><field name="related_evidence_ids"/><field name="attachment_ids" widget="many2many_binary"/></page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field></record>
    <record id="view_pm_qms_scar_search" model="ir.ui.view"><field name="name">pm.qms.scar.search</field><field name="model">pm.qms.scar</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="supplier_id"/><filter name="open" string="Open" domain="[('state','not in',('closed','cancelled'))]"/><filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/><filter name="returned" string="Returned" domain="[('state','=','returned')]"/><filter name="group_supplier" string="Supplier" context="{'group_by':'supplier_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field></record>
    <record id="action_pm_qms_scar" model="ir.actions.act_window"><field name="name">SCAR</field><field name="res_model">pm.qms.scar</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_pm_qms_scar_search"/></record>
</odoo>
