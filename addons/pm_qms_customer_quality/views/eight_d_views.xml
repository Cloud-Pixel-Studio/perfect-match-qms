<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_qms_eight_d_list" model="ir.ui.view">
        <field name="name">pm.qms.eight.d.list</field><field name="model">pm.qms.eight.d</field>
        <field name="arch" type="xml"><list decoration-danger="is_overdue" decoration-success="state == 'closed'" decoration-muted="state == 'cancelled'"><field name="code"/><field name="name"/><field name="source_type"/><field name="organization_id"/><field name="owner_id"/><field name="due_date"/><field name="progress_percent"/><field name="state"/></list></field>
    </record>
    <record id="view_pm_qms_eight_d_form" model="ir.ui.view">
        <field name="name">pm.qms.eight.d.form</field><field name="model">pm.qms.eight.d</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'draft'"/>
                    <button name="action_create_root_cause" type="object" string="Root Cause" class="btn-secondary"/>
                    <button name="action_create_capa" type="object" string="Create / Open CAPA" class="btn-secondary"/>
                    <button name="action_move_to_capa" type="object" string="CAPA" invisible="state != 'active'"/>
                    <button name="action_start_effectiveness" type="object" string="Effectiveness" invisible="state not in ('active', 'capa')"/>
                    <button name="action_mark_effective" type="object" string="Accept Effectiveness" invisible="state != 'effectiveness_review'"/>
                    <button name="action_close" type="object" string="Close" invisible="state != 'effectiveness_review'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('closed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,capa,effectiveness_review,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1><h2><field name="code"/></h2></div>
                    <group><group><field name="organization_id"/><field name="process_id"/><field name="company_id" groups="base.group_multi_company"/><field name="source_type"/><field name="owner_id"/><field name="due_date"/><field name="is_overdue"/></group><group><field name="complaint_id"/><field name="ncr_id"/><field name="supplier_issue_id"/><field name="scar_id"/><field name="customer_id"/><field name="supplier_id"/><field name="progress_percent"/></group></group>
                    <notebook>
                        <page string="Problem"><field name="problem_statement"/><field name="d0_preparation"/><field name="d2_problem_description"/></page>
                        <page string="Team"><field name="team_person_ids"/><field name="d1_team"/></page>
                        <page string="Containment"><field name="d3_containment"/></page>
                        <page string="Root Cause"><field name="root_cause_analysis_id"/><field name="d4_root_cause"/></page>
                        <page string="CAPA"><field name="capa_ids"/><field name="d5_corrective_action"/><field name="d6_implementation"/></page>
                        <page string="Prevention &amp; Closure"><field name="d7_prevention"/><field name="d8_closure"/><field name="lessons_learned"/></page>
                        <page string="Effectiveness"><field name="effectiveness_review_date"/><field name="effectiveness_result"/><field name="effectiveness_notes"/></page>
                        <page string="Evidence"><field name="related_document_ids"/><field name="related_evidence_ids"/><field name="attachment_ids" widget="many2many_binary"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_pm_qms_eight_d_search" model="ir.ui.view"><field name="name">pm.qms.eight.d.search</field><field name="model">pm.qms.eight.d</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><filter name="open" string="Open" domain="[('state','not in',('closed','cancelled'))]"/><filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field></record>
    <record id="action_pm_qms_eight_d" model="ir.actions.act_window"><field name="name">8D Cases</field><field name="res_model">pm.qms.eight.d</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_pm_qms_eight_d_search"/></record>
</odoo>
